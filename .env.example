# Auto-Caption Docker Environment Configuration
# Copy this file to .env and adjust values as needed

# Jupyter Configuration
JUPYTER_PORT=8888
JUPYTER_TOKEN=
JUPYTER_PASSWORD=
JUPYTER_ENABLE_LAB=yes
JUPYTER_ALLOW_ROOT=true

# GPU Configuration
# Set to 'all' to use all GPUs, or specify GPU IDs like '0,1'
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# Model Cache Directories
TORCH_HOME=/root/.cache/torch
HF_HOME=/root/.cache/huggingface
WHISPER_CACHE=/root/.cache/whisper

# Volume Paths (relative to docker-compose directory)
NOTEBOOKS_DIR=./notebooks
DATA_DIR=./data
CACHE_DIR=./cache
OUTPUT_DIR=./outputs

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONWARNINGS=ignore

# Auto-Caption Configuration
AUTO_CAPTION_MODEL=base
AUTO_CAPTION_LANGUAGE=en
AUTO_CAPTION_DEVICE=cuda
AUTO_CAPTION_BATCH_SIZE=16

# Whisper Model Selection (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Emotion Detection Settings
EMOTION_MODEL_PATH=/workspace/cache/emotion_model.pth
EMOTION_CONFIDENCE_THRESHOLD=0.7

# Platform Defaults
DEFAULT_PLATFORM=GENERAL
DEFAULT_STYLE_INTENSITY=MEDIUM

# Video Processing
MAX_VIDEO_SIZE_MB=500
VIDEO_SAMPLE_RATE=0.5
DEFAULT_VIDEO_QUALITY=high

# API Keys (if using external services)
# OPENAI_API_KEY=
# HUGGINGFACE_TOKEN=

# Resource Limits
DOCKER_MEMORY_LIMIT=8g
DOCKER_CPU_LIMIT=4

# Logging
LOG_LEVEL=INFO
ENABLE_DEBUG=false

# Network Configuration
COMPOSE_PROJECT_NAME=auto-caption
DOCKER_NETWORK=auto-caption-network

# Development Settings
HOT_RELOAD=true
DEV_MODE=false